{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MiRent: start dev server (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/app",
        "env": {}
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:\\s+http://localhost:[0-9]+"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
